{
  "name": "@ultrarouter/sdk",
  "version": "0.0.1",
  "description": "Official TypeScript SDK for ultrarouter, an OpenAI-compatible LLM gateway and router: typed chat, streaming, embeddings, retries, an OpenAI drop-in, a context runtime, a CLI and a GitHub Action.",
  "license": "MIT",
  "author": "ultrarouter",
  "homepage": "https://github.com/lucastonon/ultrarouter-sdk-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucastonon/ultrarouter-sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/lucastonon/ultrarouter-sdk-typescript/issues"
  },
  "keywords": [
    "ultrarouter",
    "llm",
    "llm-gateway",
    "ai-gateway",
    "llm-router",
    "model-router",
    "openai",
    "openai-compatible",
    "openrouter",
    "chat-completions",
    "streaming",
    "embeddings",
    "function-calling",
    "structured-outputs",
    "cost-optimization",
    "typescript",
    "sdk"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./context": {
      "import": {
        "types": "./dist/context.d.ts",
        "default": "./dist/context.js"
      },
      "require": {
        "types": "./dist/context.d.cts",
        "default": "./dist/context.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ur": "./dist/cli/index.cjs"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md",
    "llms.txt",
    "llms-full.txt"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "codegen": "openapi-typescript openapi/openapi.yaml -o src/generated/types.ts",
    "spec:check": "node scripts/openapi-sync.mjs --check",
    "pretypecheck": "npm run codegen",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.context.json && tsc --noEmit -p examples/tsconfig.json",
    "pretest": "npm run codegen",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prebuild": "npm run codegen",
    "build": "tsup && node scripts/bundle-zod-types.mjs",
    "contract": "node contract-tests/run-all.mjs",
    "doctest": "node scripts/doctest.mjs",
    "examples": "node scripts/run-examples.mjs",
    "docs:gen": "node scripts/gen-docs.mjs",
    "docs:check": "node scripts/gen-docs.mjs --check && node scripts/docs-claims.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/size-check.mjs",
    "smoke": "node scripts/pack-smoke.mjs",
    "leak-scan": "node scripts/leak-scan.mjs",
    "check": "npm run spec:check && npm run format:check && npm run typecheck && npm run test && npm run build && npm run contract && npm run doctest && npm run examples && npm run docs:check && npm run size && npm run smoke && npm run leak-scan",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "js-yaml": "^4.3.2",
    "openai": "^6.49.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "zod": "3.25.76"
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
